{
  "name": "@aperture/api",
  "version": "0.7.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:routes": "node --import tsx --test src/lib/afterRestore.test.ts src/routes/backup/handlers/upload.test.ts src/routes/media-proxy/images.test.ts src/routes/routeGuards.test.ts src/routes/annSettingsCallSites.test.ts src/routes/libraryScopeCallSites.test.ts src/routes/displayRatingCallSites.test.ts src/lib/scoreBreakdown.test.ts src/lib/qualityRating.test.ts src/lib/countryFilter.test.ts src/lib/watcherFilter.test.ts src/routes/listQuerystrings.test.ts src/routes/media-proxy/imageSize.test.ts src/routes/analysis/provenance.test.ts",
    "test:security": "node --import tsx --test src/config/security.test.ts src/config/cors.test.ts",
    "test:boot": "node --import tsx --test --test-force-exit src/serverBoot.test.ts src/plugins/static.test.ts src/lib/restoreGate.server.test.ts",
    "test:auth": "node --import tsx --test src/lib/impersonation.test.ts src/lib/providerCredentials.test.ts src/lib/accountEnabled.test.ts src/lib/permissions.test.ts src/lib/watcherAudience.test.ts src/lib/secretExposure.test.ts src/lib/jobProgressToken.test.ts src/lib/restoreGate.test.ts",
    "test:schemas": "node --import tsx --test src/routes/aiFunctionSchemas.test.ts src/routes/settings/dislikeBehaviorSchema.test.ts src/routes/settings/librarySchema.test.ts",
    "test:jobs": "node --import tsx --test src/routes/jobs/jobDefaults.test.ts src/routes/jobs/state.test.ts src/routes/jobs/configDrift.test.ts src/routes/jobs/runLimit.test.ts src/routes/jobs/mediaServerTurns.test.ts",
    "test:gap-analysis": "node --import tsx --test --test-force-exit src/routes/gap-analysis/movieScanState.test.ts",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test:assistant": "node --import tsx --test src/routes/assistant/discovery/enrichReasons.test.ts src/routes/assistant/discovery/webCandidates.test.ts src/routes/assistant/tools/tasteBlend.test.ts src/routes/assistant/tools/episodes.test.ts src/routes/assistant/tools/semanticOrder.test.ts src/routes/assistant/tools/titleLimits.test.ts src/routes/assistant/tools/upcoming.test.ts src/routes/assistant/tools/toolSchemas.test.ts src/routes/assistant/helpers/routeIntent.test.ts src/routes/assistant/helpers/titleMatch.test.ts src/routes/assistant/helpers/countryMatch.test.ts src/routes/assistant/tools/toolArgs.test.ts src/routes/assistant/helpers/turnStop.test.ts",
    "test:search": "node --import tsx --test src/routes/search/searchSql.test.ts src/routes/seerr/sources/seerrMapping.test.ts src/routes/seerr/requestOptions.test.ts",
    "test:issues": "node --import tsx --test src/routes/issues/issueMapping.test.ts",
    "docs:api": "node --import tsx scripts/api-reference.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@aperture/core": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "ai": "^5.0.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "node-cron": "^3.0.3",
    "proxy-addr": "^2.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/proxy-addr": "^2.0.3",
    "tsx": "^4.19.2"
  }
}
