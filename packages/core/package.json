{
  "name": "@aperture/core",
  "version": "0.7.8",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./db": {
      "import": "./dist/db/index.js",
      "types": "./dist/db/index.d.ts"
    },
    "./media": {
      "import": "./dist/media/index.js",
      "types": "./dist/media/index.d.ts"
    },
    "./recommender": {
      "import": "./dist/recommender/index.js",
      "types": "./dist/recommender/index.d.ts"
    },
    "./strm": {
      "import": "./dist/strm/index.js",
      "types": "./dist/strm/index.d.ts"
    },
    "./channels": {
      "import": "./dist/channels/index.js",
      "types": "./dist/channels/index.d.ts"
    },
    "./jobs": {
      "import": "./dist/jobs/index.js",
      "types": "./dist/jobs/index.d.ts"
    },
    "./watching": {
      "import": "./dist/watching/index.js",
      "types": "./dist/watching/index.d.ts"
    },
    "./countries": {
      "import": "./dist/countries/canonical.js",
      "types": "./dist/countries/canonical.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test:justwatch": "node --import tsx --test src/justwatch/normalize.test.ts",
    "test:strm": "node --import tsx --test src/strm/posterOverlay.test.ts src/strm/artwork.test.ts src/strm/nfo.test.ts",
    "test:clustering": "node --import tsx --test src/taste-profile/clustering.test.ts src/taste-profile/dispersionBands.test.ts src/recommender/shared/clusterAllocation.test.ts src/recommender/movies/candidates.test.ts",
    "test:interests": "node --import tsx --test src/recommender/shared/interestSlots.test.ts",
    "test:preferences": "node --import tsx --test src/taste-profile/preferenceRating.test.ts src/taste-profile/genreAffinity.test.ts src/taste-profile/genrePreference.test.ts src/taste-profile/detectionMerge.test.ts src/lib/diversityAdjustment.test.ts",
    "test:selection": "node --import tsx --test src/recommender/shared/mmr.test.ts",
    "test:novelty": "node --import tsx --test src/recommender/shared/novelty.test.ts src/recommender/shared/preferenceStrength.test.ts",
    "test:similarity": "node --import tsx --test src/recommender/shared/similarityScale.test.ts",
    "test:cross-media": "node --import tsx --test src/similarity/crossMedia.test.ts",
    "test:era": "node --import tsx --test src/recommender/eraDiagnostics.test.ts",
    "test:exclusion": "node --import tsx --test src/recommender/watchedExclusion.test.ts",
    "test:engagement": "node --import tsx --test src/taste-profile/engagement.test.ts src/taste-profile/ratingWeight.test.ts",
    "test:activity-gate": "node --import tsx --test src/recommender/activityGate.test.ts",
    "test:storage": "node --import tsx --test src/recommender/storage.test.ts",
    "test:canonical": "node --import tsx --test src/recommender/movies/canonicalText.test.ts",
    "test:twins": "node --import tsx --test src/recommender/shared/twinSlots.test.ts src/recommender/shared/acclaimedSlots.test.ts",
    "test:explanations": "node --import tsx --test src/recommender/shared/explanationParsing.test.ts src/recommender/shared/explanationPrompt.test.ts src/recommender/shared/slotPrompt.test.ts src/recommender/evidenceStrength.test.ts",
    "test:migrations": "node --import tsx --test src/migrations.test.ts",
    "test:schedule": "node --import tsx --test src/jobs/schedule.test.ts src/jobs/logWindow.test.ts",
    "test:discovery": "node --import tsx --test src/discover/scorer.test.ts",
    "test:enrichment": "node --import tsx --test src/enrichment/needsEnrichment.test.ts src/omdb/failures.test.ts src/omdb/ratings.test.ts",
    "test:analysis": "node --import tsx --test src/analysis/sourceFloor.test.ts src/analysis/pending.test.ts src/analysis/budget.test.ts src/analysis/response.test.ts src/lib/crw.test.ts src/lib/crwEngines.test.ts",
    "test:quota": "node --import tsx --test src/lib/webSearchQuota.test.ts",
    "test:ai-errors": "node --import tsx --test src/lib/aiErrors.test.ts",
    "test:pacing": "node --import tsx --test src/lib/callPacing.test.ts",
    "test:ratings": "node --import tsx --test src/ratings/imdbDataset.test.ts",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test:evaluation": "node --import tsx --test src/evaluation/holdout.test.ts src/evaluation/metrics.test.ts",
    "test:max-candidates": "node --import tsx --test src/lib/maxCandidates.test.ts",
    "test:embedding-sets": "node --import tsx --test src/lib/embeddingSets.test.ts",
    "test:embedding-identity": "node --import tsx --test src/lib/embeddingIdentity.test.ts src/lib/embeddingCatalog.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/deepseek": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/groq": "^2.0.0",
    "@ai-sdk/huggingface": "^1.0.13",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/openai-compatible": "^2.0.0",
    "@openrouter/ai-sdk-provider": "^1.5.4",
    "ai": "^5.0.0",
    "ai-sdk-ollama": "2.2.0",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "sharp": "^0.33.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2"
  }
}
